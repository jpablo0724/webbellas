---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const checklistLeft = [
	"Hospedaje cómodo y adaptado para tu recuperación.",
	"Cuidado de enfermería y cuidadoras las 24 horas.",
	"Nutrición especializada para favorecer tu recuperación.",
];
const checklistRight = [
	"Servicio de limpieza y lavandería.",
	"Transporte a citas médicas y traslados programados.",
	"Servicios complementarios para una recuperación integral.",
];

const stats = [
	{
		icon: "stethoscope",
		value: "10",
		suffix: "+",
		label: "Años de experiencia",
		description: "Especialistas en cuidado postoperatorio.",
	},
	{
		icon: "caring-hands",
		value: "1.000",
		suffix: "+",
		label: "Recuperaciones exitosas",
		description: "Pacientes nacionales e internacionales.",
	},
	{
		icon: "clipboard",
		value: "15",
		suffix: "+",
		label: "Aliados estratégicos",
		description: "Para una atención integral.",
	},
	{
		icon: "hospital",
		value: "14",
		suffix: "",
		label: "Servicios especializados",
		description: "Todo para tu recuperación en un mismo lugar.",
	},
];

const services = [
	{
		title: "Hospedaje especializado",
		description:
			"Instalaciones adaptadas para el cuidado postoperatorio, diseñadas para brindarte la comodidad, seguridad y tranquilidad que necesitas durante tu recuperación.",
		images: [
			`${base}/images/hospedaje/hospedaje-1.jpg`,
			`${base}/images/hospedaje/hospedaje-2.jpg`,
			`${base}/images/hospedaje/hospedaje-3.jpg`,
			`${base}/images/hospedaje/hospedaje-4.jpg`,
			`${base}/images/hospedaje/hospedaje-5.jpg`,
			`${base}/images/hospedaje/hospedaje-6.jpg`,
			`${base}/images/hospedaje/hospedaje-7.jpg`,
		],
	},
	{
		title: "Cuidado de enfermería y cuidadoras 24 horas",
		description:
			"Acompañamiento por profesionales con experiencia las 24 horas. Monitoreamos tu evolución y te brindamos atención continua para una recuperación segura y con tranquilidad.",
		image: `${base}/images/servicios/enfermeria.jpg`,
	},
	{
		title: "Nutrición especializada",
		description:
			"Alimentación pensada para tu recuperación. Ofrecemos menús balanceados y personalizados según tus necesidades nutricionales para favorecer una adecuada cicatrización y bienestar.",
		image: `${base}/images/servicios/nutricion.jpg`,
	},
	{
		title: "Limpieza y lavandería",
		description:
			"Comodidad en cada detalle. Nos encargamos de la limpieza y desinfección de tu habitación y del lavado de tus prendas para un ambiente adecuado en tu postoperatorio.",
		image: `${base}/images/servicios/lavanderia.jpg`,
	},
	{
		title: "Transporte",
		description:
			"Traslados seguros a tus citas médicas. Te acompañamos a controles, valoraciones y demás citas relacionadas con tu procedimiento, garantizando comodidad y puntualidad durante tu recuperación.",
		image: `${base}/images/servicios/transporte.jpg`,
	},
	{
		title: "Guía en el cuidado postoperatorio",
		description:
			"Te brindamos orientación en cada etapa de tu proceso quirúrgico, desde el uso de fajas y prendas adecuadas hasta tus controles, cuidados y recomendaciones, para que tengas una recuperación exitosa.",
		image: `${base}/images/servicios/guia.jpg`,
	},
];

const complementaryServices = [
	{
		title: "Masajes postquirúrgicos",
		description: "Ayudan a reducir la inflamación y favorecen la recuperación.",
	},
	{
		title: "Sueroterapia",
		description:
			"Terapias intravenosas que ayudan en el manejo del dolor, la cicatrización, el aumento de los niveles de hemoglobina y el control de los síntomas postoperatorios.",
	},
	{
		title: "Bomba del dolor",
		description: "Control continuo del dolor durante el postoperatorio.",
	},
	{
		title: "Cámara hiperbárica",
		description: "Favorece la cicatrización y acelera la recuperación postoperatoria.",
	},
	{
		title: "Almacén Bellas",
		description:
			"Encuentra todo lo que necesitas para tu cuidado postoperatorio en un solo lugar como fajas, cojines, e insumos especializados.",
	},
	{
		title: "Spa Bellas y tratamientos faciales",
		description:
			"Procedimientos especializados para el cuidado, rejuvenecimiento y bienestar integral de tu piel.",
	},
	{
		title: "Turismo",
		description: "Descubre Medellín, su cultura y sus alrededores. (Guatapé, Comuna 13, Provenza…)",
	},
	{
		title: "Enfermería a domicilio en Medellín y su Área Metropolitana",
		description:
			"Ofrecemos enfermería a domicilio como una alternativa para quienes deciden recuperarse en casa. Somos tu acompañante el día de tu cirugía y durante tu recuperación, brindándote el cuidado y apoyo profesional que necesitas.",
	},
];
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<link rel="icon" href={`${base}/favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Webbellas</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<section class="about">
			<div class="about__blob"></div>
			<div class="about__ring"></div>

			<div class="about__container">
				<div class="about__content">
					<p class="about__eyebrow">About Us</p>
					<h2 class="about__title">
						Casa de Recuperación<br />
						Bellas Te Cuida en Medellín
					</h2>
					<p class="about__subtitle">Recovery House</p>
					<p class="about__lead">
						El cuidado postoperatorio que necesitas, con la calidad humana que mereces. En
						Bellas Te Cuida somos una Recovery House en Medellín con más de 10 años de
						experiencia, especializada en el acompañamiento integral de pacientes de
						cirugía plástica, estética y reconstructiva. Nos dedicamos a brindarte una
						recuperación segura, cómoda y tranquila, respaldada por un equipo comprometido
						con tu bienestar en cada etapa del proceso.
					</p>

					<hr class="about__divider" />

					<p class="about__checklist-intro">En nuestra Recovery House encontrarás:</p>

					<div class="about__checklist">
						<ul>
							{checklistLeft.map((item) => (
								<li>
									<span class="about__check" aria-hidden="true">
										<svg viewBox="0 0 16 16" width="12" height="12">
											<path
												d="M2 8.5 6 12l8-8"
												fill="none"
												stroke="white"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"
											></path>
										</svg>
									</span>
									{item}
								</li>
							))}
						</ul>
						<ul>
							{checklistRight.map((item) => (
								<li>
									<span class="about__check" aria-hidden="true">
										<svg viewBox="0 0 16 16" width="12" height="12">
											<path
												d="M2 8.5 6 12l8-8"
												fill="none"
												stroke="white"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"
											></path>
										</svg>
									</span>
									{item}
								</li>
							))}
						</ul>
					</div>
				</div>

				<div class="about__media">
					<img
						class="about__img about__img--main"
						src="https://loremflickr.com/560/480/doctor,team"
						alt="Equipo médico"
						width="560"
						height="480"
					/>
					<img
						class="about__img about__img--secondary"
						src="https://loremflickr.com/360/320/doctor,baby"
						alt="Doctor atendiendo a una paciente"
						width="360"
						height="320"
					/>
					<button id="about-play" class="about__play" aria-label="Reproducir video" type="button">
						<svg viewBox="0 0 24 24" width="20" height="20">
							<path d="M8 5v14l11-7z" fill="white"></path>
						</svg>
					</button>
				</div>
			</div>

			<dialog id="about-video-dialog" class="video-dialog">
				<button id="about-video-close" class="video-dialog__close" aria-label="Cerrar video" type="button">
					&times;
				</button>
				<video
					id="about-video"
					class="video-dialog__video"
					controls
					playsinline
					src={`${base}/videos/bellas-casa-de-recuperacion.mp4`}
				></video>
			</dialog>
		</section>

		<section class="trust">
			<div class="trust__container">
				{stats.map((stat) => (
					<div class="trust__item">
						<span class="trust__icon" aria-hidden="true">
							{stat.icon === "stethoscope" && (
								<svg viewBox="0 0 64 64" width="56" height="56" fill="none">
									<path
										d="M20 8v16a10 10 0 0 0 20 0V8"
										stroke="white"
										stroke-width="2.5"
										stroke-linecap="round"
									></path>
									<circle cx="20" cy="8" r="3" stroke="white" stroke-width="2.5"></circle>
									<circle cx="40" cy="8" r="3" stroke="white" stroke-width="2.5"></circle>
									<path
										d="M30 32v6a12 12 0 0 0 24 0v-3"
										stroke="white"
										stroke-width="2.5"
										stroke-linecap="round"
									></path>
									<circle cx="54" cy="35" r="4" stroke="white" stroke-width="2.5"></circle>
								</svg>
							)}
							{stat.icon === "caring-hands" && (
								<svg viewBox="0 0 64 64" width="56" height="56" fill="none">
									<path
										d="M32 16c-3-5-11-5-13 1-2 5 2 9 13 18 11-9 15-13 13-18-2-6-10-6-13-1Z"
										stroke="white"
										stroke-width="2.5"
										stroke-linejoin="round"
									></path>
									<path d="M28 24h3l-2 3h4l-2 3" stroke="white" stroke-width="2" stroke-linejoin="round"></path>
									<path
										d="M10 44c4-4 8-6 8-6s3-2 6 1c2 2 1 5-1 6-3 1-8 1-8 1"
										stroke="white"
										stroke-width="2.5"
										stroke-linecap="round"
										stroke-linejoin="round"
									></path>
									<path
										d="M54 44c-4-4-8-6-8-6s-3-2-6 1c-2 2-1 5 1 6 3 1 8 1 8 1"
										stroke="white"
										stroke-width="2.5"
										stroke-linecap="round"
										stroke-linejoin="round"
									></path>
									<path
										d="M8 46c-2 3-2 7 0 9M56 46c2 3 2 7 0 9"
										stroke="white"
										stroke-width="2.5"
										stroke-linecap="round"
									></path>
								</svg>
							)}
							{stat.icon === "clipboard" && (
								<svg viewBox="0 0 64 64" width="56" height="56" fill="none">
									<rect x="14" y="10" width="36" height="46" rx="4" stroke="white" stroke-width="2.5"></rect>
									<rect x="24" y="6" width="16" height="8" rx="2" stroke="white" stroke-width="2.5"></rect>
									<rect x="21" y="26" width="6" height="6" rx="1" stroke="white" stroke-width="2"></rect>
									<path d="M33 29h11" stroke="white" stroke-width="2.5" stroke-linecap="round"></path>
									<rect x="21" y="37" width="6" height="6" rx="1" stroke="white" stroke-width="2"></rect>
									<path d="M33 40h11" stroke="white" stroke-width="2.5" stroke-linecap="round"></path>
									<rect x="21" y="48" width="6" height="6" rx="1" stroke="white" stroke-width="2"></rect>
									<path d="M33 51h11" stroke="white" stroke-width="2.5" stroke-linecap="round"></path>
								</svg>
							)}
							{stat.icon === "hospital" && (
								<svg viewBox="0 0 64 64" width="56" height="56" fill="none">
									<rect x="6" y="30" width="14" height="24" stroke="white" stroke-width="2.5"></rect>
									<rect x="44" y="30" width="14" height="24" stroke="white" stroke-width="2.5"></rect>
									<rect x="20" y="16" width="24" height="38" stroke="white" stroke-width="2.5"></rect>
									<circle cx="32" cy="10" r="7" stroke="white" stroke-width="2.5"></circle>
									<path d="M32 6.5v7M28.5 10h7" stroke="white" stroke-width="2" stroke-linecap="round"></path>
									<path d="M26 23h12M26 30h12" stroke="white" stroke-width="2" stroke-linecap="round"></path>
									<path
										d="M6 46h6l3-6 4 10 3-7 2 3h6l3-6 4 10 3-7 2 3h6"
										stroke="white"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
									></path>
								</svg>
							)}
						</span>

						<p class="trust__number">
							{stat.value}<span class="trust__accent">{stat.suffix}</span>
						</p>
						<p class="trust__label">{stat.label}</p>
						<p class="trust__desc">{stat.description}</p>
					</div>
				))}
			</div>
		</section>

		<section class="services">
			<div class="services__container">
				<h2 class="services__title">Servicios</h2>

				<div class="services__grid">
					{services.map((service) => (
						<article class="service-card">
							<h3 class="service-card__title">{service.title}</h3>
							{service.images ? (
								<div class="service-card__media service-card__media--gallery" data-gallery>
									<div class="gallery__track">
										{service.images.map((src) => (
											<img src={src} alt={service.title} loading="lazy" />
										))}
									</div>
									<div class="service-card__overlay" aria-hidden="true"></div>
									<button class="gallery__nav gallery__nav--prev" aria-label="Foto anterior" type="button">
										&#8249;
									</button>
									<button class="gallery__nav gallery__nav--next" aria-label="Foto siguiente" type="button">
										&#8250;
									</button>
									<div class="gallery__dots">
										{service.images.map((_, i) => (
											<span class={`gallery__dot ${i === 0 ? "is-active" : ""}`} data-index={i}></span>
										))}
									</div>
								</div>
							) : (
								<div class="service-card__media">
									<img src={service.image} alt={service.title} loading="lazy" />
									<div class="service-card__overlay" aria-hidden="true"></div>
								</div>
							)}
							<p class="service-card__desc">{service.description}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="complementary">
			<div class="complementary__container">
				<h2 class="complementary__title">Servicios Complementarios</h2>

				<div class="complementary__grid">
					{complementaryServices.map((item) => (
						<article class="complementary-card">
							<h3 class="complementary-card__title">{item.title}</h3>
							<p class="complementary-card__desc">{item.description}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<script>
			const dialog = document.getElementById("about-video-dialog") as HTMLDialogElement;
			const video = document.getElementById("about-video") as HTMLVideoElement;
			const openButton = document.getElementById("about-play");
			const closeButton = document.getElementById("about-video-close");

			function closeDialog() {
				video.pause();
				dialog.close();
			}

			openButton?.addEventListener("click", () => {
				dialog.showModal();
				video.currentTime = 0;
				video.play();
			});

			closeButton?.addEventListener("click", closeDialog);

			dialog.addEventListener("click", (event) => {
				if (event.target === dialog) closeDialog();
			});

			dialog.addEventListener("close", () => video.pause());
		</script>

		<script>
			document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((gallery) => {
				const track = gallery.querySelector<HTMLElement>(".gallery__track");
				const dots = Array.from(gallery.querySelectorAll<HTMLElement>(".gallery__dot"));
				const prevButton = gallery.querySelector<HTMLButtonElement>(".gallery__nav--prev");
				const nextButton = gallery.querySelector<HTMLButtonElement>(".gallery__nav--next");
				if (!track) return;

				function goTo(index: number) {
					if (!track) return;
					const clamped = Math.max(0, Math.min(index, dots.length - 1));
					track.scrollTo({ left: track.clientWidth * clamped, behavior: "smooth" });
				}

				function currentIndex() {
					if (!track) return 0;
					return Math.round(track.scrollLeft / track.clientWidth);
				}

				prevButton?.addEventListener("click", () => goTo(currentIndex() - 1));
				nextButton?.addEventListener("click", () => goTo(currentIndex() + 1));

				track.addEventListener("scroll", () => {
					const active = currentIndex();
					dots.forEach((dot, i) => dot.classList.toggle("is-active", i === active));
				});
			});
		</script>
	</body>
</html>

<style>
	:global(html) {
		font-family: "Inter", "Segoe UI", system-ui, -apple-system, sans-serif;
	}

	:global(body) {
		margin: 0;
		color: #3a4750;
	}

	.about {
		position: relative;
		overflow: hidden;
		background: #eef2f2;
		padding: 96px 0;
	}

	.about__blob {
		position: absolute;
		top: -180px;
		left: -220px;
		width: 620px;
		height: 620px;
		border-radius: 50%;
		background: radial-gradient(circle at 60% 40%, rgba(20, 166, 158, 0.16), rgba(20, 166, 158, 0) 70%);
	}

	.about__ring {
		position: absolute;
		top: 50%;
		right: -120px;
		width: 780px;
		height: 780px;
		border-radius: 50%;
		border: 1px solid rgba(20, 166, 158, 0.25);
		transform: translateY(-50%);
	}

	.about__container {
		position: relative;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 32px;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 64px;
		align-items: center;
	}

	.about__eyebrow {
		margin: 0 0 16px;
		color: #14a69e;
		font-weight: 700;
		font-size: 13px;
		letter-spacing: 2px;
		text-transform: uppercase;
	}

	.about__title {
		margin: 0 0 24px;
		color: #17212b;
		font-family: "Poppins", "Segoe UI", sans-serif;
		font-size: 42px;
		line-height: 1.2;
		font-weight: 800;
	}

	.about__subtitle {
		margin: 0 0 20px;
		color: #14a69e;
		font-family: "Poppins", "Segoe UI", sans-serif;
		font-size: 18px;
		font-weight: 600;
	}

	.about__lead {
		margin: 0 0 32px;
		color: #7c8892;
		font-size: 16px;
		line-height: 1.7;
		max-width: 46ch;
	}

	.about__divider {
		border: none;
		border-top: 1px solid rgba(20, 166, 158, 0.3);
		margin: 0 0 32px;
	}

	.about__checklist-intro {
		margin: 0 0 16px;
		color: #17212b;
		font-weight: 700;
		font-size: 16px;
	}

	.about__checklist {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0 24px;
	}

	.about__checklist ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.about__checklist li {
		display: flex;
		align-items: center;
		gap: 12px;
		color: #2f3b44;
		font-weight: 600;
		font-size: 15px;
	}

	.about__check {
		flex: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 22px;
		height: 22px;
		border-radius: 50%;
		background: #14a69e;
	}

	.about__media {
		position: relative;
		height: 520px;
	}

	.about__img {
		position: absolute;
		object-fit: cover;
		border-radius: 12px;
		box-shadow: 0 24px 48px rgba(23, 33, 43, 0.18);
	}

	.about__img--main {
		top: 0;
		right: 0;
		width: 74%;
		height: 66%;
	}

	.about__img--secondary {
		left: 0;
		bottom: 0;
		width: 54%;
		height: 46%;
		border: 6px solid #eef2f2;
	}

	.about__play {
		position: absolute;
		top: 45%;
		left: 42%;
		transform: translate(-50%, -50%);
		width: 64px;
		height: 64px;
		border-radius: 50%;
		border: none;
		background: #14d9c6;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 12px 24px rgba(20, 217, 198, 0.45);
		cursor: pointer;
	}

	@media (max-width: 900px) {
		.about__container {
			grid-template-columns: 1fr;
		}

		.about__title {
			font-size: 32px;
		}

		.about__media {
			height: 420px;
		}
	}

	@media (max-width: 520px) {
		.about__columns,
		.about__checklist {
			grid-template-columns: 1fr;
		}

		.about__media {
			height: 340px;
		}
	}

	.video-dialog {
		position: fixed;
		inset: 0;
		margin: auto;
		width: min(900px, 92vw);
		padding: 0;
		border: none;
		border-radius: 12px;
		background: black;
		overflow: visible;
	}

	.video-dialog::backdrop {
		background: rgba(15, 23, 27, 0.75);
	}

	.video-dialog__video {
		display: block;
		width: 100%;
		max-height: 80vh;
		border-radius: 12px;
	}

	.video-dialog__close {
		position: absolute;
		top: -44px;
